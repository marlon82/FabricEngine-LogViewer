<Window x:Class="LogViewer2.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Extreme Networks FabricEngine (VOSS) Log Viewer" Width="1440" Height="850" MinWidth="1050" MinHeight="650" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" Icon="Assets/LogViewer.ico">
 <Window.Resources>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinWidth" Value="105"/><Setter Property="Height" Value="36"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <DockPanel Background="{DynamicResource Canvas}">
  <Border DockPanel.Dock="Top" Background="{DynamicResource Header}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="18,10">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal"><Image Source="Assets/LogViewer.png" Width="38" Height="38"/><StackPanel Margin="11,0"><TextBlock Text="Extreme Networks FabricEngine (VOSS) Log Viewer" Foreground="{DynamicResource Ink}" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="SubtitleText" Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="UpdateButton" Height="36" Click="UpdateButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" Margin="0,0,7,0"/><TextBlock x:Name="UpdateLabel"/></StackPanel><Button.ContextMenu><ContextMenu><MenuItem x:Name="CheckUpdatesMenu" Click="CheckUpdates_Click"><MenuItem.Icon><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}"/></MenuItem.Icon></MenuItem><Separator/><MenuItem x:Name="IncludePrereleasesMenu" IsCheckable="True" StaysOpenOnClick="True" Click="IncludePrereleases_Click"/></ContextMenu></Button.ContextMenu></Button><Button x:Name="ThemeButton" Height="36" ToolTip="Dark mode" Click="ThemeButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" Margin="0,0,7,0"/><TextBlock x:Name="ThemeLabel" Text="Dark"/></StackPanel></Button><Button x:Name="LanguageButton" Height="36" Margin="0" ToolTip="Sprache / Language" Click="LanguageButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" Margin="0,0,7,0"/><TextBlock x:Name="LanguageLabel" Text="DE"/></StackPanel></Button></StackPanel>
   </Grid>
  </Border>
  <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource Subtle}"><StatusBarItem><TextBlock x:Name="StatusText"/></StatusBarItem><Separator/><StatusBarItem><TextBlock x:Name="CountText"/></StatusBarItem><Separator/><StatusBarItem><TextBlock x:Name="FileText"/></StatusBarItem></StatusBar>
  <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5" Padding="7" Margin="0,0,0,10">
    <WrapPanel><Button x:Name="OpenButton" Style="{StaticResource PrimaryButton}" Click="Open_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/><TextBlock x:Name="OpenLabel"/></StackPanel></Button><Button x:Name="AddButton" Style="{StaticResource NavButton}" Click="Add_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" Margin="0,0,7,0"/><TextBlock x:Name="AddLabel"/></StackPanel></Button><Button x:Name="SortButton" Style="{StaticResource NavButton}" Click="SortButton_Click"><StackPanel Orientation="Horizontal"><TextBlock x:Name="SortIcon" Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" Margin="0,0,7,0"/><TextBlock x:Name="SortLabel"/></StackPanel></Button><Button x:Name="ColumnsButton" Style="{StaticResource NavButton}" Click="ColumnsButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE14C;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" Margin="0,0,7,0"/><TextBlock x:Name="ColumnsLabel"/></StackPanel><Button.ContextMenu><ContextMenu><MenuItem x:Name="ShowIdMenu" Tag="Id" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" Click="ColumnVisibility_Click"/><MenuItem x:Name="ShowDateMenu" Tag="Date" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" Click="ColumnVisibility_Click"/><MenuItem x:Name="ShowTimeMenu" Tag="Time" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" Click="ColumnVisibility_Click"/><MenuItem x:Name="ShowModuleMenu" Tag="Module" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" Click="ColumnVisibility_Click"/><MenuItem x:Name="ShowEventMenu" Tag="Event" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" Click="ColumnVisibility_Click"/><MenuItem x:Name="ShowAlarmMenu" Tag="Alarm" IsCheckable="True" IsChecked="False" StaysOpenOnClick="True" Click="ColumnVisibility_Click"/><MenuItem x:Name="ShowVrfMenu" Tag="Vrf" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" Click="ColumnVisibility_Click"/><MenuItem x:Name="ShowCategoryMenu" Tag="Category" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" Click="ColumnVisibility_Click"/><MenuItem x:Name="ShowSeverityMenu" Tag="Severity" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" Click="ColumnVisibility_Click"/><MenuItem x:Name="ShowMessageMenu" Tag="Message" IsCheckable="True" IsChecked="True" StaysOpenOnClick="True" Click="ColumnVisibility_Click"/></ContextMenu></Button.ContextMenu></Button><Button x:Name="CatalogButton" Style="{StaticResource NavButton}" Click="CatalogButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" Margin="0,0,7,0"/><TextBlock x:Name="CatalogLabel"/></StackPanel><Button.ContextMenu><ContextMenu><MenuItem x:Name="ImportCatalogMenu" Click="ImportCatalog_Click"><MenuItem.Icon><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}"/></MenuItem.Icon></MenuItem><MenuItem x:Name="ImportCatalogFolderMenu" Click="ImportCatalogFolder_Click"><MenuItem.Icon><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}"/></MenuItem.Icon></MenuItem><MenuItem x:Name="DownloadGitHubCatalogsMenu" Click="DownloadGitHubCatalogs_Click"><MenuItem.Icon><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}"/></MenuItem.Icon></MenuItem><Separator/><MenuItem x:Name="SelectCatalogFolderMenu" Click="SelectCatalogFolder_Click"><MenuItem.Icon><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}"/></MenuItem.Icon></MenuItem><MenuItem x:Name="OpenCatalogFolderMenu" Click="OpenCatalogFolder_Click"><MenuItem.Icon><TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}"/></MenuItem.Icon></MenuItem></ContextMenu></Button.ContextMenu></Button><Button x:Name="ExportButton" Style="{StaticResource NavButton}" Click="Export_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/><TextBlock x:Name="ExportLabel"/></StackPanel></Button><Button x:Name="ClearButton" Style="{StaticResource NavButton}" Click="Clear_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="#E55B65" Margin="0,0,7,0"/><TextBlock x:Name="ClearLabel"/></StackPanel></Button><Button x:Name="StatsButton" Style="{StaticResource NavButton}" Click="Stats_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/><TextBlock x:Name="StatsLabel"/></StackPanel></Button><Separator Margin="8,3"/><TextBlock x:Name="DropHint" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="8,0"/></WrapPanel>
   </Border>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,8,0"><TextBlock x:Name="SearchFieldLabel" FontWeight="SemiBold" Margin="3,0,0,3"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6,0,0,6"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBox x:Name="SearchBox" Grid.Column="1" FontSize="14" TextChanged="Filter_Changed" BorderThickness="0,1,1,1"/></Grid></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock x:Name="ModuleFieldLabel" FontWeight="SemiBold" Margin="3,0,0,3"/><Button x:Name="ModuleFilterButton" HorizontalContentAlignment="Left" Click="FilterButton_Click"><TextBlock x:Name="ModuleFilterText" TextTrimming="CharacterEllipsis" TextAlignment="Left"/></Button></StackPanel>
    <StackPanel Grid.Column="2" Margin="0,0,8,0"><TextBlock x:Name="SeverityFieldLabel" FontWeight="SemiBold" Margin="3,0,0,3"/><Button x:Name="SeverityFilterButton" HorizontalContentAlignment="Left" Click="FilterButton_Click"><TextBlock x:Name="SeverityFilterText" TextTrimming="CharacterEllipsis" TextAlignment="Left"/></Button></StackPanel>
    <StackPanel Grid.Column="3" Margin="0,0,8,0"><TextBlock x:Name="CategoryFieldLabel" FontWeight="SemiBold" Margin="3,0,0,3"/><Button x:Name="CategoryFilterButton" HorizontalContentAlignment="Left" Click="FilterButton_Click"><TextBlock x:Name="CategoryFilterText" TextTrimming="CharacterEllipsis" TextAlignment="Left"/></Button></StackPanel>
    <Button x:Name="ResetButton" Grid.Column="4" VerticalAlignment="Bottom" Content="Zurücksetzen" Click="ResetFilters_Click"/>
   </Grid>
   <Grid Grid.Row="2" Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="10,6"><StackPanel Orientation="Horizontal"><TextBlock x:Name="SystemLabel" FontWeight="SemiBold"/><TextBlock x:Name="SystemInfo" Text="—" Margin="5,0,22,0" ToolTipService.ShowDuration="30000"/><TextBlock x:Name="SourceLabel" FontWeight="SemiBold"/><TextBlock x:Name="SourceInfo" Text="—" Margin="5,0" ToolTipService.ShowDuration="30000"/></StackPanel></Border><TextBlock x:Name="FilterHint" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="12,0,2,0"/></Grid>
   <DataGrid x:Name="LogGrid" Grid.Row="3" AutoGenerateColumns="False" ItemsSource="{Binding View}" MouseDoubleClick="LogGrid_MouseDoubleClick" PreviewMouseRightButtonDown="LogGrid_RightClick" Sorting="LogGrid_Sorting" Background="{DynamicResource Panel}" Foreground="{DynamicResource Ink}" RowBackground="{DynamicResource Panel}" AlternatingRowBackground="{DynamicResource Alternate}" FontSize="12">
    <DataGrid.ContextMenu><ContextMenu><MenuItem x:Name="CopyMenu" Click="Copy_Click"><MenuItem.Icon><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}"/></MenuItem.Icon></MenuItem><Separator/><MenuItem x:Name="FilterMessageMenu" Click="FilterMessage_Click"><MenuItem.Icon><TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}"/></MenuItem.Icon></MenuItem><MenuItem x:Name="FilterEventMenu" Click="FilterEvent_Click"><MenuItem.Icon><TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}"/></MenuItem.Icon></MenuItem><Separator/><MenuItem x:Name="ExplainEventMenu" Click="ExplainEvent_Click"><MenuItem.Icon><TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Accent}"/></MenuItem.Icon></MenuItem><MenuItem x:Name="DetailsMenu" Click="Details_Click"><MenuItem.Icon><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"/></MenuItem.Icon></MenuItem></ContextMenu></DataGrid.ContextMenu>
    <DataGrid.Columns><DataGridTextColumn x:Name="IdColumn" Header="#" Binding="{Binding Id}" Width="Auto"/><DataGridTextColumn x:Name="DateColumn" Binding="{Binding Date}" Width="Auto"/><DataGridTextColumn x:Name="TimeColumn" Binding="{Binding Time}" Width="Auto"/><DataGridTextColumn x:Name="ModuleColumn" Binding="{Binding Module}" Width="Auto"/><DataGridTextColumn x:Name="EventColumn" Header="Event-ID" Binding="{Binding EventId}" Width="Auto"/><DataGridTextColumn x:Name="AlarmColumn" Header="Alarm-ID" Binding="{Binding AlarmId}" Width="Auto" Visibility="Collapsed"/><DataGridTextColumn x:Name="VrfColumn" Header="VRF" Binding="{Binding Vrf}" Width="Auto"/><DataGridTextColumn x:Name="CategoryColumn" Binding="{Binding Category}" Width="Auto"/><DataGridTextColumn x:Name="SeverityColumn" Binding="{Binding Severity}" Width="Auto"/><DataGridTextColumn x:Name="MessageColumn" Binding="{Binding Message}" Width="*" MinWidth="220"/></DataGrid.Columns>
   </DataGrid>
   <TextBlock x:Name="FooterHint" Grid.Row="4" Foreground="{DynamicResource Muted}" Margin="2,6,0,0"/>
  </Grid>
 </DockPanel>
</Window>
